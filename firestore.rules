rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /parties/{partyId} {
      // 任何人皆可讀取練功團資料
      allow read: if true;
      
      // 任何人皆可建立練功團，初始狀態必須是招募中、人數為 0、名單為空陣列
      allow create: if request.resource.data.status == '招募中'
                    && request.resource.data.expectedCount == 0
                    && request.resource.data.creatorHash is string
                    && request.resource.data.server is string
                    && request.resource.data.leaderId is string
                    && request.resource.data.memberCharIds is list
                    && request.resource.data.memberCharIds.size() == 0;
      
      // 允許更新：確保伺服器、發起人 ID 與創立者 Hash 絕不可被竄改，且已結束/已關閉的招募不可再修改
      // 同時實施欄位隔離：跟團/退團只能修改 memberCharIds 與 expectedCount；招募維護只能修改內容相關欄位
      allow update: if resource.data.status != '已結束'
                    && resource.data.status != '已關閉'
                    && request.resource.data.server == resource.data.server
                    && request.resource.data.leaderId == resource.data.leaderId
                    && request.resource.data.creatorHash == resource.data.creatorHash
                    && (
                      // 分支 1: 一般成員跟團/退團 (只允許變更名單與計數)
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCharIds', 'expectedCount'])
                      ||
                      // 分支 2: 招募內容維護 (允許變更標題、地點、時間、需求、狀態、關團原因、推播標記)
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'title', 'location', 'customLocation', 'startTime', 'endTime', 
                        'requirements', 'status', 'closeReason', 'notified10min'
                      ])
                    );
      
      // 徹底禁止客戶端直接刪除文檔，防止惡意清空資料庫 (P2)
      allow delete: if false;
    }
    
    // 允許所有人讀寫訂閱關係資料夾，以便註冊與取消 FCM Token
    match /party_subscriptions/{subId} {
      allow read, write: if true;
    }
    
    // 允許所有人讀寫全站通知 Token 資料夾
    match /global_tokens/{tokenId} {
      allow read, write: if true;
    }

    // 7. 統一身分使用者集合安全性規則
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.server is string
                    && request.resource.data.dept is string
                    && request.resource.data.charId is string
                    && request.resource.data.questionId is number
                    && request.resource.data.answerHash is string;
      allow update, delete: if false; // 基於安全考量，一旦註冊便不可被竄改或刪除
    }

    // 8. 任務指南集合安全性規則
    // 前端唯讀；資料由 scripts/upload_tasks_to_firestore.js 以 Admin SDK 寫入 (不受 rules 限制)
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if false;
    }

    // 9. 中介資料 (Metadata) 安全性規則
    // 前端唯讀 (維護設定、任務/技能版本)；由 scripts/ 下的管理腳本以 Admin SDK 寫入
    match /metadata/{metaId} {
      allow read: if true;
      allow write: if false;
    }

    // 11. 已完成任務同步集合安全性規則
    match /completed_tasks/{docId} {
      allow read, write: if true;
    }

    // 12. 技能模擬器資料集合安全性規則
    // 前端唯讀；資料由 scripts/upload_skills.js 以 Admin SDK 寫入
    match /skills/{skillId} {
      allow read: if true;
      allow write: if false;
    }

    // 13. 使用者技能庫集合安全性規則
    match /skill_builds/{docId} {
      allow read, write: if true;
    }

    // 14. 技能模擬器分享配點集合安全性規則
    match /shared_builds/{shareId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // 15. 公告系統集合安全性規則
    // 前端唯讀；公告由 scripts/upload_new_notice.js、sync_notices_to_firestore.js 以 Admin SDK 寫入
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if false;
    }

    // 16. 技能資料修正提案
    // - 任何人可讀取；建立「待審核」的提案需帶有提案人角色名稱（欄位白名單＋長度限制）
    //   註：網站只讓登入的使用者提案，但目前沒有 Firebase Auth，rules 只能檢查名稱不為空，無法驗證身分
    // - 前端唯一能做的修改：提案人憑撤回密鑰把自己「待審核」的提案改為「已撤回」
    // - 採納、站長撤回、刪除只能以 Admin SDK 執行（本機 dev server 的審核 API），不受 rules 限制
    match /skill_proposals/{proposalId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly([
                        'skillGroupId', 'skillName', 'treeId', 'job', 'skillTree', 'levels',
                        'changes', 'before', 'reason', 'authorCharId',
                        'status', 'reviewNote', 'reviewedAt', 'createdAt'
                      ])
                    && request.resource.data.keys().hasAll([
                        'skillGroupId', 'skillName', 'treeId', 'job', 'skillTree', 'levels',
                        'changes', 'before', 'reason', 'authorCharId',
                        'status', 'reviewNote', 'reviewedAt', 'createdAt'
                      ])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.reviewNote == ''
                    && request.resource.data.reviewedAt == null
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.skillGroupId is string
                    && request.resource.data.skillGroupId.size() > 0
                    && request.resource.data.skillGroupId.size() <= 60
                    && request.resource.data.skillName is string
                    && request.resource.data.skillName.size() <= 60
                    && request.resource.data.treeId is string
                    && request.resource.data.treeId.size() <= 60
                    && request.resource.data.job is string
                    && request.resource.data.job.size() <= 30
                    && request.resource.data.skillTree is string
                    && request.resource.data.skillTree.size() <= 30
                    && request.resource.data.levels is list
                    && request.resource.data.levels.size() <= 20
                    && request.resource.data.changes is map
                    && request.resource.data.changes.size() > 0
                    && request.resource.data.changes.keys().hasOnly(['description', 'levels'])
                    && (!('description' in request.resource.data.changes)
                        || (request.resource.data.changes.description is string
                            && request.resource.data.changes.description.size() <= 2000))
                    && request.resource.data.before is map
                    && request.resource.data.before.keys().hasOnly(['description', 'levels'])
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() > 0
                    && request.resource.data.reason.size() <= 1000
                    && request.resource.data.authorCharId is string
                    && request.resource.data.authorCharId.size() > 0
                    && request.resource.data.authorCharId.size() <= 30
                    // 撤回密鑰必須在同一個批次中一併建立
                    && existsAfter(/databases/$(database)/documents/skill_proposal_secrets/$(proposalId));

      // 撤回：只能由「待審核」改為「已撤回」，且要附上正確的撤回密鑰
      allow update: if resource.data.status == 'pending'
                    && request.resource.data.status == 'withdrawn'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewNote', 'reviewedAt', 'withdrawSecret'])
                    && request.resource.data.reviewNote == '提案人自行撤回'
                    && request.resource.data.reviewedAt == request.time
                    && request.resource.data.withdrawSecret is string
                    && request.resource.data.withdrawSecret ==
                         get(/databases/$(database)/documents/skill_proposal_secrets/$(proposalId)).data.secret;

      allow delete: if false;
    }

    // 17. 技能修正提案的撤回密鑰
    // 前端永遠讀不到，只能在建立提案的同一個批次中寫入一次
    match /skill_proposal_secrets/{proposalId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['secret'])
                    && request.resource.data.secret is string
                    && request.resource.data.secret.size() == 32
                    && !exists(/databases/$(database)/documents/skill_proposals/$(proposalId))
                    && getAfter(/databases/$(database)/documents/skill_proposals/$(proposalId)).data.status == 'pending';
    }
  }
}
