rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /parties/{partyId} {
      // 任何人皆可讀取練功團資料
      allow read: if true;
      
      // 任何人皆可建立練功團，初始狀態必須是招募中、人數為 0、名單為空陣列
      allow create: if request.resource.data.status == '招募中'
                    && request.resource.data.expectedCount == 0
                    && request.resource.data.creatorHash is string
                    && request.resource.data.server is string
                    && request.resource.data.leaderId is string
                    && request.resource.data.memberCharIds is list
                    && request.resource.data.memberCharIds.size() == 0;
      
      // 允許更新：確保伺服器、發起人 ID 與創立者 Hash 絕不可被竄改，且已結束/已關閉的招募不可再修改
      // 同時實施欄位隔離：跟團/退團只能修改 memberCharIds 與 expectedCount；招募維護只能修改內容相關欄位
      allow update: if resource.data.status != '已結束'
                    && resource.data.status != '已關閉'
                    && request.resource.data.server == resource.data.server
                    && request.resource.data.leaderId == resource.data.leaderId
                    && request.resource.data.creatorHash == resource.data.creatorHash
                    && (
                      // 分支 1: 一般成員跟團/退團 (只允許變更名單與計數)
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCharIds', 'expectedCount'])
                      ||
                      // 分支 2: 招募內容維護 (允許變更標題、地點、時間、需求、狀態、關團原因、推播標記)
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'title', 'location', 'customLocation', 'startTime', 'endTime', 
                        'requirements', 'status', 'closeReason', 'notified10min'
                      ])
                    );
      
      // 徹底禁止客戶端直接刪除文檔，防止惡意清空資料庫 (P2)
      allow delete: if false;
    }
    
    // 允許所有人讀寫訂閱關係資料夾，以便註冊與取消 FCM Token
    match /party_subscriptions/{subId} {
      allow read, write: if true;
    }
    
    // 允許所有人讀寫全站通知 Token 資料夾
    match /global_tokens/{tokenId} {
      allow read, write: if true;
    }

    // 7. 統一身分使用者集合安全性規則
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.server is string
                    && request.resource.data.dept is string
                    && request.resource.data.charId is string
                    && request.resource.data.questionId is number
                    && request.resource.data.answerHash is string;
      allow update, delete: if false; // 基於安全考量，一旦註冊便不可被竄改或刪除
    }

    // 8. 任務指南集合安全性規則
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }

    // 9. 中介資料 (Metadata) 安全性規則
    match /metadata/{metaId} {
      allow read, write: if true;
    }

    // 11. 已完成任務同步集合安全性規則
    match /completed_tasks/{docId} {
      allow read, write: if true;
    }

    // 12. 技能模擬器資料集合安全性規則
    match /skills/{skillId} {
      allow read, write: if true;
    }

    // 13. 使用者技能庫集合安全性規則
    match /skill_builds/{docId} {
      allow read, write: if true;
    }

    // 14. 技能模擬器分享配點集合安全性規則
    match /shared_builds/{shareId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // 15. 公告系統集合安全性規則
    match /notices/{noticeId} {
      allow read, write: if true;
    }
  }
}
